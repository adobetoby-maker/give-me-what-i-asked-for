{
  "description": "Global auto-bootstrap hooks for Toby's Claude Code workspace",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/prompt-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/bootstrap/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/bootstrap/memory-writeback.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/stop-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/stop-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/message-display-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_playwright_playwright__browser_take_screenshot",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.command/hooks/actually-getting-what-i-asked-for.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Vercel__deploy_to_vercel",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/eyes-precheck.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_vercel_vercel__*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/eyes-precheck.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/deploy-gate.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/code-gate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/visual-block.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/eyes-precheck.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/eyes-precheck.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/eyes-precheck.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/scope-check.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/scope-check.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/command-boot.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_playwright_playwright__browser_navigate",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/wizard-boot.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_chrome-devtools-mcp_chrome-devtools__navigate_page",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/wizard-boot.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/research-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/post-read-clear.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/visual-gate.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/visual-clear.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/commit-gate.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/drive/.claude/hooks/build-eyes.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
